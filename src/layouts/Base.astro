---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/games.css';
import '../styles/playful.css';
import '../styles/features.css';
import '../styles/interview.css';
import '../styles/diagrams.css';
import SearchPalette from '../components/ui/SearchPalette.tsx';
import { site, nav, footerNav } from '../site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  progress?: boolean;
  /** Colours the page in a track's hue. */
  track?: { color: string; on: string };
  /** Absolute path of a social preview image, relative to the site root. */
  image?: string;
}

const { title, description = site.description, progress = false, track, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase(image ?? '/og.png'), Astro.site).href : undefined;
const trackStyle = track ? `--track:${track.color};--on-track:${track.on}` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120f3d" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: news and lessons`} href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      /* Runs before first paint: no flash of the wrong theme or depth. */
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        function get(k) {
          try {
            var v = localStorage.getItem(k);
            return v ? JSON.parse(v) : null;
          } catch (e) {
            return null;
          }
        }
        var t = get('layerwise:theme');
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        var depth = get('layerwise:depth');
        if (depth !== 'essentials' && depth !== 'full') depth = get('layerwise:path') === 'newcomer' ? 'essentials' : 'full';
        d.setAttribute('data-depth', depth);
      })();
    </script>
  </head>
  <body class:list={[track && 'has-track']} style={trackStyle}>
    <a class="skip" href="#main">Skip to content</a>
    {progress && <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase('/')} aria-label={`${site.name} home`}>
          <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M2 5h18M4 11h14M7 17h8" stroke-linecap="round"></path>
            <circle cx="11" cy="11" r="2.4" stroke="none"></circle>
          </svg>
          {site.name}
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={withBase(item.href)} aria-current={path.startsWith(withBase(item.href)) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-tools">
          <button type="button" class="icon-btn" id="search-open" aria-label="Search (Ctrl or Command plus K)" title="Search">
            <svg viewBox="0 0 20 20" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"></circle><path d="M13 13l5 5"></path></svg>
          </button>
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="Colour theme: automatic" title="Colour theme">
            <svg viewBox="0 0 20 20" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <g class="t-auto"><circle cx="10" cy="10" r="6.5"></circle><path d="M10 3.5v13" ></path><path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" stroke="none"></path></g>
              <g class="t-light"><circle cx="10" cy="10" r="3.4"></circle><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"></path></g>
              <g class="t-dark"><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7z"></path></g>
            </svg>
          </button>
          <button type="button" class="icon-btn menu-btn" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
            <svg viewBox="0 0 20 20" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>{site.name}. {site.tagline}.</p>
          <p class="licence">
            Lessons and teaching material: <a href={site.contentLicence.url} rel="license noopener">{site.contentLicence.label}</a>, reuse freely with credit. Code: <a href={`${site.repo}/blob/main/LICENSE`} rel="noopener">MIT</a>.
          </p>
        </div>
        <ul>
          {footerNav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
          <li><a href={withBase('/rss.xml')}>RSS</a></li>
          {site.repo && <li><a href={site.repo}>Source on GitHub</a></li>}
        </ul>
      </div>
    </footer>

    <SearchPalette client:idle />

    <script is:inline>
      (function () {
        var d = document.documentElement;

        /* theme: auto -> light -> dark -> auto */
        var btn = document.getElementById('theme-toggle');
        function mode() { return d.getAttribute('data-theme') || 'auto'; }
        function label() { btn.setAttribute('aria-label', 'Colour theme: ' + mode() + '. Activate to change.'); btn.setAttribute('data-mode', mode()); }
        if (btn) {
          label();
          btn.addEventListener('click', function () {
            var next = { auto: 'light', light: 'dark', dark: 'auto' }[mode()];
            if (next === 'auto') d.removeAttribute('data-theme'); else d.setAttribute('data-theme', next);
            try {
              if (next === 'auto') localStorage.removeItem('layerwise:theme'); else localStorage.setItem('layerwise:theme', JSON.stringify(next));
            } catch (e) {}
            label();
          });
        }

        /* search button opens the palette island */
        var s = document.getElementById('search-open');
        if (s) s.addEventListener('click', function () { window.dispatchEvent(new Event('layerwise:search-open')); });

        /* mobile menu */
        var m = document.getElementById('menu-toggle');
        var nav = document.getElementById('site-nav');
        if (m && nav) {
          m.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            m.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          nav.addEventListener('click', function (e) { if (e.target.closest('a')) { nav.classList.remove('is-open'); m.setAttribute('aria-expanded', 'false'); } });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { nav.classList.remove('is-open'); m.setAttribute('aria-expanded', 'false'); } });
        }

        /* scroll reveal: elements arrive once, as they enter the viewport */
        var els = [].slice.call(document.querySelectorAll('[data-reveal], .squig'));
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); }
        else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
          els.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>

    {
      progress && (
        <script is:inline>
          (function () {
            var bar = document.getElementById('reading-progress');
            if (!bar) return;
            function update() {
              var h = document.documentElement;
              var max = h.scrollHeight - h.clientHeight;
              bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, h.scrollTop / max) : 0) + ')';
            }
            addEventListener('scroll', update, { passive: true });
            addEventListener('resize', update);
            update();
          })();
        </script>
      )
    }
  </body>
</html>
