---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
const home = withBase('/interview/');
---

<Base title="Interview" description="The interview builder has moved. Read answers by topic instead.">
  <meta slot="head" http-equiv="refresh" content={`0; url=${home}`} />
  <div class="wrap">
    <header class="page-head">
      <h1>This page has moved</h1>
      <p>The interview section is now a set of answers you can read by topic, with diagrams and examples. <a href={home}>Go to the interview answers</a>.</p>
    </header>
  </div>
  <script is:inline define:vars={{ home }}>
    location.replace(home);
  </script>
</Base>
