---
import Base from '../../../layouts/Base.astro';
import TrackIcon from '../../../components/ui/TrackIcon.astro';
import { questions, roles, ilevels, kinds, type Question } from '../../../data/interview';
import { answers } from '../../../data/interview/answers';
import { categories, groupByCategory, type CategorySet } from '../../../data/interview/categories';
import { swatch } from '../../../lib/palette';
import { cardStyle } from '../../../lib/color';
import { withBase } from '../../../lib/url';

export function getStaticPaths() {
  return groupByCategory(questions).map((set) => ({ params: { category: set.category.id }, props: { set } }));
}
const { set } = Astro.props as { set: CategorySet };
const { category } = set;
const written = set.questions.filter((q) => q.id in answers).length;
const blocks = [
  { level: 'junior' as const, title: 'Fundamentals', note: 'Start here. Junior-level questions.' },
  { level: 'mid' as const, title: 'Going deeper', note: 'Mid-level questions.' },
  { level: 'senior' as const, title: 'Advanced', note: 'Senior-level questions, often a whole design or a judgement call.' },
]
  .map((b) => ({ ...b, items: set.questions.filter((q) => q.level === b.level) }))
  .filter((b) => b.items.length > 0);
const others = categories.filter((c) => c.id !== category.id);
const roleList = (q: Question) => q.roles.slice(0, 3).map((r) => roles[r]);
---

<Base title={category.title} description={`${category.promise} ${set.questions.length} interview questions with answers.`}>
  <div class="wrap">
    <header class="page-head iv-cat-head" style={cardStyle(swatch[category.swatch])}>
      <p class="crumbs"><a href={withBase('/interview/')}>Interview answers</a> <span aria-hidden="true">/</span> <span>{category.title}</span></p>
      <span class="iv-plate"><TrackIcon name={category.icon} size={44} /></span>
      <h1>{category.title}</h1>
      <p>{category.intro}</p>
      <p class="iv-hero-note">{set.questions.length} questions, from fundamentals to advanced. {written > 0 ? `${written} with a full written answer and diagram.` : 'Full written answers are on their way.'}</p>
    </header>

    {
      blocks.map((b) => (
        <section class="iv-level-block" aria-labelledby={`lv-${b.level}`}>
          <h2 id={`lv-${b.level}`}>{b.title}</h2>
          <p>{b.note}</p>
          <ul class="iv-qlist">
            {b.items.map((q) => {
              const a = answers[q.id];
              return (
                <li>
                  <article class="iv-qcard">
                    <p class="iv-meta">
                      <span class={`iv-chip k-${q.kind}`}>{kinds[q.kind]}</span>
                      <span class="iv-chip">{ilevels[q.level]}</span>
                      {roleList(q).map((r) => <span class="iv-tag">{r}</span>)}
                      {q.roles.length > 3 && <span class="iv-tag">and {q.roles.length - 3} more</span>}
                    </p>
                    <h3><a href={withBase(`/interview/q/${q.id}/`)}>{q.prompt}</a></h3>
                    {a ? (
                      <p class="iv-qshort"><b>The short answer</b>{a.short}</p>
                    ) : (
                      <div class="iv-qpoints">
                        <b>A good answer covers</b>
                        <ul>{q.strong.slice(0, 2).map((s) => <li>{s}</li>)}</ul>
                      </div>
                    )}
                    <a class="iv-more" href={withBase(`/interview/q/${q.id}/`)}>
                      {a ? 'Read the full answer, with the diagram' : 'See all the key points'}<span aria-hidden="true"> →</span>
                    </a>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <nav class="iv-cat-nav" aria-labelledby="more-h">
      <h2 id="more-h">Other topics</h2>
      <ul>
        {others.map((c) => <li><a href={withBase(`/interview/c/${c.id}/`)} style={cardStyle(swatch[c.swatch])}>{c.title}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
