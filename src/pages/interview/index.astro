---
import Base from '../../layouts/Base.astro';
import TrackIcon from '../../components/ui/TrackIcon.astro';
import InterviewFinder from '../../components/interview/InterviewFinder.tsx';
import { questions } from '../../data/interview';
import { answers } from '../../data/interview/answers';
import { groupByCategory, categoryOf } from '../../data/interview/categories';
import { swatch } from '../../lib/palette';
import { cardStyle, cardColors } from '../../lib/color';
import { withBase } from '../../lib/url';

const sets = groupByCategory(questions);
const written = Object.keys(answers).length;
const items = questions.map((q) => ({ id: q.id, prompt: q.prompt, cat: categoryOf(q), roles: q.roles, level: q.level, topics: q.topics, answered: q.id in answers }));
const finderCategories = sets.map((s) => {
  const { fill, on } = cardColors(swatch[s.category.swatch]);
  return { id: s.category.id, title: s.category.title, style: { '--fill': fill, '--on': on } };
});
---

<Base title="Interview answers" description="Answers to AI interview questions, by topic, with diagrams and worked examples. For anyone learning AI and for people preparing for interviews.">
  <div class="wrap">
    <header class="page-head">
      <h1>Interview <span class="squig" style="--squig:#E69A00">answers</span></h1>
      <p>
        Pick a topic and read the answer: a short version first, then a picture, then the explanation with a worked example. It is for anyone learning how AI works, and for people getting ready for an interview. {questions.length} questions in {sets.length} topics.
      </p>
      <p class="iv-hero-note">
        {written} questions have a full written answer with a diagram so far. The rest show the key points a good answer covers, and more are being written.
      </p>
    </header>

    <InterviewFinder client:load items={items} categories={finderCategories}>
      <section class="iv-cats" aria-labelledby="cats-h">
        <h2 id="cats-h" class="sr-only">Topics</h2>
        <div class="lp-grid lp-grid-3">
          {
            sets.map((s) => {
              const done = s.questions.filter((q) => q.id in answers).length;
              return (
                <a class="lp-card" href={withBase(`/interview/c/${s.category.id}/`)} style={cardStyle(swatch[s.category.swatch])}>
                  <span class="lp-plate"><TrackIcon name={s.category.icon} size={44} /></span>
                  <span class="lp-body">
                    <h3>{s.category.title}</h3>
                    <p>{s.category.promise}</p>
                  </span>
                  <span class="lp-chip iv-cat-count">{s.questions.length} questions{done > 0 ? `, ${done} with a full answer` : ''}</span>
                </a>
              );
            })
          }
        </div>
      </section>
    </InterviewFinder>
  </div>
</Base>
