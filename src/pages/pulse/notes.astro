---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { getPulse, formatDate } from '../../lib/content';

const entries = await getPulse();
---

<Base title="News notes we explain" description="Short, checked notes on what changed in AI and why an engineer should care.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes we explain</h1>
      <p>Short, dated notes on changes that matter for the systems you build, each read and checked by a person and linked to its source. For the day-to-day list, see <a href={withBase('/pulse/')}>News</a>. Follow along with the <a href={withBase('/rss.xml')}>RSS feed</a>, which also announces new lessons.</p>
    </header>
    {
      entries.length === 0 ? (
        <p style="margin-top:2rem">No notes yet. Add a Markdown file to <code>src/content/pulse</code> to publish the first one.</p>
      ) : (
        <ul class="rows" style="margin-top:1rem">
          {entries.map((e) => (
            <li>
              <a class="row pulse-row" href={withBase(`/pulse/${e.id}/`)}>
                <span class="meta">{formatDate(e.data.date)}</span>
                <div>
                  <h3>{e.data.title}</h3>
                  {e.data.tags.length > 0 && <p class="tags">{e.data.tags.map((t) => <span>{t}</span>)}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

  </div>
</Base>
