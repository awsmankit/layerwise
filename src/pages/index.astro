---
import Base from '../layouts/Base.astro';
import StackExplorer from '../components/viz/StackExplorer.tsx';
import HeroFlow from '../components/viz/HeroFlow.tsx';
import ContinueCard from '../components/ui/ContinueCard.tsx';
import GameBadge from '../components/games/GameBadge.tsx';
import TrackIcon from '../components/ui/TrackIcon.astro';
import { site } from '../site';
import { tracks } from '../data/tracks';
import { paths, pathIds } from '../data/paths';
import { games } from '../data/games';
import { withBase } from '../lib/url';
import { cardStyle } from '../lib/color';
import { swatch, gameSwatch } from '../lib/palette';
import { cases } from '../data/cases';
import { watch } from '../data/watch';
import { lessonVideos } from '../data/videos';
import { labs, labById } from '../data/labs';
import { libraries } from '../data/libraries';
import { getLessons, formatDate } from '../lib/content';
import headlines from '../data/headlines.json';

const lessons = await getLessons();
const videoCount = new Set([...watch.map((w) => w.url), ...Object.values(lessonVideos).flat().map((v) => v.url)]).size;
const latest = headlines.items.slice(0, 5);
const featuredLabs = ['cosine-search', 'chunk-overlap', 'tool-loop'].map((id) => labById(id)).filter((l) => l !== undefined);

const trackTiles = tracks.map((t) => ({ ...t, count: lessons.filter((l) => l.data.track === t.id).length }));

const gameColors: Record<string, { c: string; icon: string }> = {
  blueprint: { c: swatch[gameSwatch.blueprint], icon: 'blueprint' },
  'cost-crunch': { c: swatch[gameSwatch['cost-crunch']], icon: 'crunch' },
  'fit-the-model': { c: swatch[gameSwatch['fit-the-model']], icon: 'fit' },
  'rack-and-stack': { c: swatch[gameSwatch['rack-and-stack']], icon: 'infra' },
  'incident-room': { c: swatch[gameSwatch['incident-room']], icon: 'incident' },
};

const tools = [
  { href: '/tools/cost/', title: 'Cost calculator', body: 'Monthly spend, and which lever saves most.', icon: 'cost', c: swatch.navy },
  { href: '/tools/memory/', title: 'Model memory', body: 'Will this model fit on that device?', icon: 'fit', c: swatch.yellow },
  { href: '/tools/gpu/', title: 'GPU explorer', body: 'Which GPUs hold it, and how fast.', icon: 'infra', c: swatch.magenta },
  { href: '/tools/breakeven/', title: 'API or own GPUs?', body: 'Where renting GPUs starts to win.', icon: 'systems', c: swatch.lime },
  { href: '/tools/latency/', title: 'Latency budget', body: 'Cloud or on-device, for your time limit.', icon: 'serving', c: swatch.purple },
  { href: '/tools/sandbox/', title: 'Sandbox', body: 'Run tool commands and real Python.', icon: 'local', c: swatch.forest },
];

---

<Base>
  <section class="lp-hero">
    <div class="wrap">
      <h1 aria-label={site.tagline}>
        <span>How AI systems work,</span>
        <span class="lp-accent">one layer at a time</span>
      </h1>
      <div class="lp-hero-row">
        <p>Interactive lessons, games and interview prep, from your first question to running AI in production.</p>
        <div class="lp-hero-cta">
          <a class="btn" href={withBase('/start/')}>Find your starting point</a>
          <a class="btn quiet" href={withBase('/learn/')}>Browse lessons</a>
        </div>
      </div>
      <ContinueCard client:load />
      <HeroFlow client:load />
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="path-h">
    <div class="lp-head">
      <h2 id="path-h">Where do you start?</h2>
      <p>Pick the one that sounds like you.</p>
    </div>
    <div class="lp-grid lp-grid-3" data-stagger>
      {
        pathIds.map((id) => {
          const p = paths[id];
          const nl = p.steps.filter((x) => x.kind === 'lesson').length;
          const ng = p.steps.length - nl;
          return (
            <a class="lp-card" data-reveal href={withBase(`/start/#${id}`)} style={cardStyle(p.color)}>
              <span class="lp-plate"><TrackIcon name={p.icon} size={44} /></span>
              <span class="lp-body">
                <h3>{p.title}</h3>
                <p>{p.short}</p>
              </span>
              <span class="lp-chip">{nl} lessons{ng > 0 ? ` + ${ng} game${ng > 1 ? 's' : ''}` : ''}</span>
            </a>
          );
        })
      }
      <a class="lp-card lp-card-quiet" data-reveal href={withBase('/start/#check')} style="--c:#FFFFFF;--fill:#FFFFFF;--on:#15123D">
        <span class="lp-plate"><TrackIcon name="evals" size={44} /></span>
        <span class="lp-body">
          <h3>Not sure?</h3>
          <p>Six questions, two minutes.</p>
        </span>
        <span class="lp-chip">Take the check</span>
      </a>
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="tracks-h">
    <div class="lp-head">
      <h2 id="tracks-h">Every lesson, by topic</h2>
      <p>{lessons.length} lessons in {tracks.length} topics.</p>
    </div>
    <div class="lp-grid lp-grid-4" data-stagger>
      {
        trackTiles.map((t) => (
          <a class="lp-card lp-card-row" data-reveal href={withBase(`/learn/${t.id}/`)} style={cardStyle(t.color)} title={t.blurb}>
            <span class="lp-plate"><TrackIcon name={t.id} size={40} /></span>
            <span class="lp-body">
              <h3>{t.title}</h3>
              <p>{t.count} {t.count === 1 ? 'lesson' : 'lessons'}</p>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="stack-h">
    <div class="lp-head">
      <h2 id="stack-h">The layers of an AI product</h2>
      <p>From the app down to the hardware. Pick a layer.</p>
    </div>
    <StackExplorer client:load />
  </section>

  <section class="lp-tint lp-tint-pink" aria-labelledby="play-h">
    <div class="lp-section wrap">
      <div class="lp-head">
        <h2 id="play-h">Practise with games</h2>
        <p>Make an engineer's decisions and see what they cost.</p>
      </div>
      <div class="lp-grid lp-grid-5" data-stagger>
        {
          games.map((g) => {
            const gc = gameColors[g.id];
            return (
              <a class="lp-card lp-card-col" data-reveal href={withBase(g.href)} style={cardStyle(gc.c)}>
                <span class="lp-plate"><TrackIcon name={gc.icon} size={44} /></span>
                <span class="lp-body">
                  <h3>{g.title}</h3>
                  <p>{g.tagline}</p>
                </span>
                <span class="lp-chip"><GameBadge client:load prefix={g.prefix} ids={g.levelIds} /></span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="lab-h">
    <div class="lp-head">
      <h2 id="lab-h">Write code, see what passes</h2>
      <p>Short labs that run in your browser. Nothing is uploaded.</p>
    </div>
    <div class="lp-grid lp-grid-4" data-stagger>
      {
        featuredLabs.map((l, i) => (
          <a class="lp-card lp-card-col" data-reveal href={withBase(`/practice/${l.id}/`)} style={cardStyle([swatch.turquoise, swatch.tangerine, swatch.purple][i])}>
            <span class="lp-plate"><TrackIcon name="local" size={44} /></span>
            <span class="lp-body">
              <h3>{l.title}</h3>
              <p>{l.goal.split('. ')[0].replace(/\.$/, '')}.</p>
            </span>
            <span class="lp-chip">{l.minutes} min, {l.level}</span>
          </a>
        ))
      }
      <a class="lp-card lp-card-col" data-reveal href={withBase('/practice/')} style={cardStyle(swatch.navy)}>
        <span class="lp-plate"><TrackIcon name="systems" size={44} /></span>
        <span class="lp-body">
          <h3>All {labs.length} labs</h3>
          <p>Plus projects to build and free places to practise.</p>
        </span>
        <span class="lp-chip">Practice</span>
      </a>
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="iv-h">
    <div class="lp-head">
      <h2 id="iv-h">Interview prep, both sides</h2>
      <p>For candidates, and for the people interviewing them.</p>
    </div>
    <div class="lp-grid lp-grid-3" data-stagger>
      <a class="lp-card" data-reveal href={withBase('/interview/practice/')} style={cardStyle(swatch.purple)}>
        <span class="lp-plate"><TrackIcon name="llm" size={44} /></span>
        <span class="lp-body">
          <h3>Practise answering</h3>
          <p>A question for your role, against the clock.</p>
        </span>
        <span class="lp-chip">Candidates</span>
      </a>
      <a class="lp-card" data-reveal href={withBase('/interview/run/')} style={cardStyle(swatch.lime)}>
        <span class="lp-plate"><TrackIcon name="evals" size={44} /></span>
        <span class="lp-body">
          <h3>Run an interview</h3>
          <p>A question set, follow-ups and a scorecard.</p>
        </span>
        <span class="lp-chip">Interviewers</span>
      </a>
      <a class="lp-card" data-reveal href={withBase('/interview/')} style={cardStyle(swatch.magenta)}>
        <span class="lp-plate"><TrackIcon name="systems" size={44} /></span>
        <span class="lp-body">
          <h3>How AI interviews work</h3>
          <p>What each round tests, and how to answer.</p>
        </span>
        <span class="lp-chip">Guides</span>
      </a>
    </div>
  </section>

  <section class="lp-tint lp-tint-mint" aria-labelledby="tools-h">
    <div class="lp-section wrap">
      <div class="lp-head">
        <h2 id="tools-h">Calculators and a sandbox</h2>
        <p>Your own numbers. Every default is a labelled example.</p>
      </div>
      <div class="lp-grid lp-grid-3" data-stagger>
        {
          tools.map((t) => (
            <a class="lp-card lp-card-row" data-reveal href={withBase(t.href)} style={cardStyle(t.c)}>
              <span class="lp-plate"><TrackIcon name={t.icon} size={40} /></span>
              <span class="lp-body">
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="more-h">
    <div class="lp-head">
      <h2 id="more-h">Go further</h2>
      <p>Learn from other people's work.</p>
    </div>
    <div class="lp-grid lp-grid-4" data-stagger>
      <a class="lp-card" data-reveal href={withBase('/cases/')} style={cardStyle(swatch.turquoise)}>
        <span class="lp-plate"><TrackIcon name="systems" size={44} /></span>
        <span class="lp-body">
          <h3>How big companies build it</h3>
          <p>Engineering write-ups on RAG, agents, serving and evals.</p>
        </span>
        <span class="lp-chip">{cases.length} write-ups</span>
      </a>
      <a class="lp-card" data-reveal href={withBase('/libraries/')} style={cardStyle(swatch.navy)}>
        <span class="lp-plate"><TrackIcon name="infra" size={44} /></span>
        <span class="lp-body">
          <h3>AI libraries map</h3>
          <p>Agents, RAG, vector stores, evals and more, with status and licence.</p>
        </span>
        <span class="lp-chip">{libraries.length} libraries</span>
      </a>
      <a class="lp-card" data-reveal href={withBase('/watch/')} style={cardStyle(swatch.tangerine)}>
        <span class="lp-plate"><TrackIcon name="llm" size={44} /></span>
        <span class="lp-body">
          <h3>Learning videos</h3>
          <p>YouTube videos for every lesson, from well-known creators.</p>
        </span>
        <span class="lp-chip">{videoCount} videos and courses</span>
      </a>
      <a class="lp-card" data-reveal href={withBase('/teach/')} style={cardStyle(swatch.purple)}>
        <span class="lp-plate"><TrackIcon name="start" size={44} /></span>
        <span class="lp-body">
          <h3>Teaching this?</h3>
          <p>Course plans, handouts and printable lessons.</p>
        </span>
        <span class="lp-chip">For teachers</span>
      </a>
    </div>
  </section>

  <section class="lp-section wrap" aria-labelledby="pulse-h">
    <div class="lp-head">
      <h2 id="pulse-h">News</h2>
      <p>The latest from official sources, refreshed daily. <a href={withBase('/pulse/')}>All news</a></p>
    </div>
    <ul class="rows">
      {
        latest.map((h) => (
          <li>
            <a class="row pulse-row" href={h.url} target="_blank" rel="noopener noreferrer">
              <span class="meta">{formatDate(new Date(h.date))}</span>
              <div>
                <h3>
                  {h.title}
                  <span class="sr-only"> (opens {h.org} in a new tab)</span>
                </h3>
                <p class="tags"><span>{h.org}</span></p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
